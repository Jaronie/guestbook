<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Guestbook Form</title>
  <!-- css file -->
  <link rel="stylesheet" href="/styles/styles.css">
  <link rel="stylesheet" href="/styles/nav-bar.css">
  <!-- script -->
  <script src="app.js" defer></script>
  <script src="/js/validation.js" defer>
  </script>
  <!-- favicon -->
  <link rel="icon" type="image/x-icon" href="/images/me.jpg">
</head>

<body>
      <!--Nav Bar -->
    <header class = "nav-header">
      <nav>
        <ul>
          <li><a href="https://jaronie.github.io/jaron-bautista-portfolio/">Home</a></li>
          <li><a href="http://24.199.115.154:3004">Contact Page</a></li>
          <li><a href="/admin">Admin Page</a></li>
          <li><a href="https://github.com/Jaronie/guestbook/">Github Repository</a></li>
          <li><a href="https://www.linkedin.com/in/jaron-bautista">LinkedIn</a></li>
        </ul>
      </nav>
    </header>
  <main>
    <header>
      <h1>Contact Form</h1>
    </header>
    <section class="top">
      <!-- form  -->
      <form id="guest-form" action="/submit" method="post">

        <div class="field">
          <!-- first name -->
          <label for="fname">First Name: <span class="err" id="err-fname">*First name required.</span></label>
          <input type="text" id="fname" name="fname">
        </div>
        <!-- last name -->
        <div class="field">
          <label for="lname">Last Name: <span class="err" id="err-lname">*Last name required.</span>
          </label>
          <input type="text" id="lname" name="lname">
        </div>
        <!-- job title -->
        <div class="field">
          <label for="job-title">Job Title:<span class="err" id="err-job-title">*Job title required.</span></label>
          <input type="text" id="job-title" name="job-title">
        </div>
        <!-- company -->
        <div class="field">
          <label for="company">Company:<span class="err" id="err-company">*Company required.</span></label> <input type="text" id="company" name="company">
        </div>
        <!-- linkedin -->
        <div class="field">
          <label for="linkedin">LinkedIn URL:<span class="err" id="err-linkedin">*LinkedIn URL required.</span></label> <input type="text" id="linkedin" name="linkedin">
        </div>
        <!-- email -->
        <div class="field">
          <label for="email">Email:<span class="err" id="err-email">*Email required.</span></label> <input type="text" id="email" name="email">
        </div>
    </section>
    <!-- middle section -->
    <section class="middle">
      <label>How did we meet?<span class="err" id="err-meet">*Please select an option.</span></label>
      <select name="meet" id="meet" onclick="otherToggle()">
        <option value="none">Please select</option>
        <option value="placeholder">Placeholder</option>
        <option value="other">Other</option>
      </select>
      <!-- other -->
       <div class="other-field">
      <label for="other">
        Other (please specify):
        <input type="text" id="other" name="other">
      </label>
        </div>
    </section>

    <!-- bottom section -->
    <label for="message">
      Message:
    </label>
    <textarea id="message" name="message" rows="4" cols="50"></textarea>
    </section>

    <!-- mailing list -->
    <section class="bottom">
      <input type="checkbox" id="mailing-list" name="mailing-list" value="yes" onclick="mailingListToggle()"> <!-- toggle function -->
      <label for="mailing-list">Add me to your mailing list
      </label>
      <br>
      <div class="email-format">
        <label for="form-type">Choose an email format:</label>
        <div class="radio-row">
          <input type="radio" name="form-type" value="html">
          <label for="form-type">HTML</label>
          <input type="radio" name="form-type" value="text">
          <label for="form-type">Text</label>
        </div>
      </div>
    </section>
    <button type="submit" id="submit-button">Submit</button>
    </form>

  </main>


</body>

</html>