<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <!-- favicon -->
  <link rel="icon" type="image/x-icon" href="/images/me.jpg">
    <!-- css file -->
    <link rel="stylesheet" href="/styles/confirm_styles.css">
    <link rel="stylesheet" href="/styles/nav-bar.css">
    <title>Confirmation</title>
</head>
<body>
          <!--Nav Bar -->
    <header class = "nav-header">
      <nav>
        <ul>
          <li><a href="https://jaronie.github.io/jaron-bautista-portfolio/">Home</a></li>
          <li><a href="http://24.199.115.154:3004">Contact Page</a></li>
          <li><a href="/admin">Admin Page</a></li>
          <li><a href="https://github.com/Jaronie/guestbook/">Github Repository</a></li>
          <li><a href="https://www.linkedin.com/in/jaron-bautista">LinkedIn</a></li>
        </ul>
      </nav>
    </header>
    
    <main>
    <header>
      <h1>Contact Form Details</h1>
    </header>
    <section class="confirmation">
        <h1>Thank you for your submission, <%= entry.fname %> <%= entry.lname %>!
        </h1>
            <p>I'll try my best to get back to you. Here's what you submitted:</p>
    </section>
    <div id = "confirmation-details">
        <p><strong>First Name:</strong> <%= entry.fname %></p>
        <p><strong>Last Name:</strong> <%= entry.lname %></p>
        <p><strong>Email:</strong> <%= entry.email %></p>
        <p><strong>Company:</strong> <%= entry.company %></p>
        <p><strong>Job Title:</strong> <%= entry.job %></p>
        <p><strong>LinkedIn URL:</strong> <%= entry.linkedin %></p>
        <p><strong>How We Met:</strong> <%= entry.meet %></p>
        <p><strong>Message:</strong></p>
        <article><%= (entry.message) ? entry.message : "No message provided" %></article>
        <p><strong>Mail Type:</strong> <%= (entry.mail_function) ? entry.mail_function : "Opted out" %></p>
    </div>
    </main>
</body>
</html>