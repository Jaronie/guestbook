<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <!-- Scripts -->
    <script src="//code.jquery.com/jquery-3.7.1.js"></script>
    <script src="//cdn.datatables.net/2.3.7/js/dataTables.js"></script>
    <script src="//cdn.datatables.net/responsive/3.0.2/js/dataTables.responsive.min.js"></script>

    <!-- Styles -->
    <link rel="stylesheet" href="//cdn.datatables.net/2.3.7/css/dataTables.dataTables.css">
    <link rel="stylesheet" href="//cdn.datatables.net/responsive/3.0.2/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="/styles/nav-bar.css">
</head>
<body>
          <!--Nav Bar -->
<%- include('nav-bar') %>
    
    <h1>Form Submissions</h1>
    <table id="submit-table" class="display">
        <thead>
            <tr>
                <th>Time</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Company</th>
                <th>Job</th>
                <th>LinkedIn</th>
                <th>How We Met</th>
                <th>Mail Type</th>                         
            </tr>
        </thead>
        <tbody>
    <% entries.forEach(entry => { %>
        <tr>
            <td><%= entry.timestamp.toLocaleString() %></td>
            <td><%= entry.fname %></td>
            <td><%= entry.lname %></td>
            <td><%= entry.email %></td>
            <td><%= entry.company %></td>
            <td><%= entry.job %></td>
            <td><%= entry.linkedin %></td>
            <td><%= entry.meet %></td>
            <td><%= entry.mail_function %></td>
            <td><%= entry.message %></td>
        </tr>
    <% }) %>
        </tbody>    
    </table>

    <script>
        new DataTable('#submit-table', {
            responsive: true
        });
    </script>
</body>
</html>